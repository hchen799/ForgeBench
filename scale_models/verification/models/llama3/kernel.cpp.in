// Configurable signed fixed point. Products carry 2*FRAC fractional bits.
// The generated header selects proven-safe 64-bit or 128-bit accumulators.
// Maximum dimensions in model_config.h guarantee no reduction overflow.
#include "top.h"
#include "nonlinear_tables.h"
#include "verification_trace.h"
#include <cstdint>

static data_t W_TILE[TILE_OUT][TILE_IN];
static data_t X_TILE[PREFILL_TILE][TILE_IN];
static wide_t ACC_TILE[PREFILL_TILE][TILE_OUT];
static data_t SCORES[MAX_CTX];
static uint32_t EXP_WEIGHTS[MAX_CTX];

static data_t saturate_data(wide_t code) {
    if (code > DATA_MAX) return static_cast<data_t>(DATA_MAX);
    if (code < DATA_MIN) return static_cast<data_t>(DATA_MIN);
    return static_cast<data_t>(code);
}

static wide_t floor_shift(wide_t value, int shift) {
    if (value >= 0) return value >> shift;
    return -static_cast<wide_t>((static_cast<uwide_t>(-value) + ((uwide_t(1) << shift) - 1)) >> shift);
}

static data_t round_data(wide_t value, int fractional_drop) {
    return saturate_data(floor_shift(value + (wide_t(1) << (fractional_drop - 1)), fractional_drop));
}

static uwide_t integer_sqrt(uwide_t value) {
    uwide_t result = 0;
    // Restoring square root, exactly 64 iterations, no floating-point shortcut.
    uwide_t bit = uwide_t(1) << 126;
    for (int step = 0; step < 64; ++step) {
        if (value >= result + bit) {
            value -= result + bit;
            result = (result >> 1) + bit;
        } else {
            result >>= 1;
        }
        bit >>= 2;
    }
    return result;
}

static uwide_t rounded_sqrt(uwide_t value) {
    uwide_t root = integer_sqrt(value);
    // Compare the fractional remainder to root + 1/4 without squaring 2*root.
    if (value - root * root > root) ++root;
    return root;
}

static data_t rounded_ratio(wide_t numerator, uint64_t denominator) {
    wide_t q = numerator / static_cast<wide_t>(denominator);
    wide_t r = numerator % static_cast<wide_t>(denominator);
    if (r >= 0) {
        if (uint64_t(r) * 2 >= denominator) ++q;
    } else if (uint64_t(-r) * 2 > denominator) {
        --q;
    }
    return saturate_data(q);
}

static wide_t grid_index(wide_t code) {
    if (FRAC >= 11) return floor_shift(code, FRAC - 11);
    return code * (wide_t(1) << ((FRAC < 11) ? 11 - FRAC : 0));
}

static data_t silu_value(data_t code) {
    if (wide_t(code) >= (wide_t(32) << FRAC)) return code;
    if (wide_t(code) <= -(wide_t(32) << FRAC)) return 0;
    wide_t index = grid_index(code);
    int offset = static_cast<int>(index) + 65536;
    if (FRAC <= 11) return SILU[offset];
    wide_t unit = wide_t(1) << ((FRAC > 11) ? FRAC - 11 : 0);
    wide_t fraction = wide_t(code) - index * unit;
    wide_t value = wide_t(SILU[offset]) * (unit - fraction) + wide_t(SILU[offset + 1]) * fraction;
    return round_data(value, FRAC - 11);
}

static uint32_t exp_value(wide_t delta) {
    if (delta >= (wide_t(32) << FRAC)) return 0;
    wide_t index = grid_index(delta);
    int offset = static_cast<int>(index);
    if (FRAC <= 11) return EXP_NEG[offset];
    wide_t unit = wide_t(1) << ((FRAC > 11) ? FRAC - 11 : 0);
    wide_t fraction = delta - index * unit;
    wide_t value = wide_t(EXP_NEG[offset]) * (unit - fraction) + wide_t(EXP_NEG[offset + 1]) * fraction;
    return static_cast<uint32_t>((value + unit / 2) / unit);
}

static void linear(const data_t *input, const data_t *weights, data_t *output,
                   int rows, int in_dim, int out_dim) {
    for (int co = 0; co < out_dim; co += TILE_OUT) {
        int no = (co + TILE_OUT <= out_dim) ? TILE_OUT : out_dim - co;
        for (int r = 0; r < rows; ++r)
            for (int o = 0; o < no; ++o) ACC_TILE[r][o] = 0;
        for (int ci = 0; ci < in_dim; ci += TILE_IN) {
            int ni = (ci + TILE_IN <= in_dim) ? TILE_IN : in_dim - ci;
            for (int o = 0; o < no; ++o)
                for (int i = 0; i < ni; ++i)
                    W_TILE[o][i] = weights[uint64_t(co + o) * in_dim + ci + i];
            for (int r = 0; r < rows; ++r)
                for (int i = 0; i < ni; ++i)
                    X_TILE[r][i] = input[r * in_dim + ci + i];
            for (int r = 0; r < rows; ++r) {
                for (int o = 0; o < no; ++o) {
                    wide_t sum = ACC_TILE[r][o];
                    for (int i = 0; i < ni; ++i) {
                        #pragma HLS pipeline II=1
                        sum += wide_t(X_TILE[r][i]) * W_TILE[o][i];
                    }
                    ACC_TILE[r][o] = sum;
                }
            }
        }
        for (int r = 0; r < rows; ++r)
            for (int o = 0; o < no; ++o)
                output[r * out_dim + co + o] = round_data(ACC_TILE[r][o], FRAC);
    }
}

static void rmsnorm(const data_t *input, const data_t *gamma, data_t *output, int rows) {
    for (int r = 0; r < rows; ++r) {
        uwide_t sum = 0;
        for (int c = 0; c < HIDDEN; ++c) {
            wide_t x = input[r * HIDDEN + c];
            sum += x * x;
        }
        uwide_t mean = sum / HIDDEN + EPSILON_Q;
        uwide_t root = rounded_sqrt(mean << (2 * FRAC));
        uwide_t inverse = (uwide_t(1) << (4 * FRAC)) / root;
        for (int c = 0; c < HIDDEN; ++c) {
            wide_t product = wide_t(input[r * HIDDEN + c]) * gamma[c] * static_cast<wide_t>(inverse);
            output[r * HIDDEN + c] = round_data(product, 3 * FRAC);
        }
    }
}

static void rope(data_t *values, const data_t *table, int rows, int heads, int start_pos) {
    for (int r = 0; r < rows; ++r) {
        for (int h = 0; h < heads; ++h) {
            for (int d = 0; d < HEAD_DIM; d += 2) {
                uint64_t offset = uint64_t(start_pos + r) * HEAD_DIM + d;
                data_t cosine = table[offset], sine = table[offset + 1];
                int index = (r * heads + h) * HEAD_DIM + d;
                wide_t x = values[index], y = values[index + 1];
                values[index] = round_data(x * cosine - y * sine, FRAC);
                values[index + 1] = round_data(x * sine + y * cosine, FRAC);
            }
        }
    }
}

static void attention(const data_t *q, const data_t *keys, const data_t *values,
                      data_t *output, int rows, int start_pos) {
    for (int r = 0; r < rows; ++r) {
        int visible = start_pos + r + 1; // Future keys never enter softmax.
        for (int h = 0; h < Q_HEADS; ++h) {
            int kh = h / (Q_HEADS / KV_HEADS);
            data_t maximum = static_cast<data_t>(DATA_MIN);
            for (int t = 0; t < visible; ++t) {
                wide_t score = 0;
                for (int d = 0; d < HEAD_DIM; ++d)
                    score += wide_t(q[r * HIDDEN + h * HEAD_DIM + d]) * keys[t * KV_DIM + kh * HEAD_DIM + d];
                SCORES[t] = round_data(score * wide_t(SCORE_SCALE_Q), 3 * FRAC);
                if (SCORES[t] > maximum) maximum = SCORES[t];
            }
            uint64_t denominator = 0;
            for (int t = 0; t < visible; ++t) {
                wide_t delta = wide_t(maximum) - wide_t(SCORES[t]);
                EXP_WEIGHTS[t] = exp_value(delta);
                denominator += EXP_WEIGHTS[t];
            }
            for (int d = 0; d < HEAD_DIM; ++d) {
                wide_t numerator = 0;
                for (int t = 0; t < visible; ++t)
                    numerator += wide_t(EXP_WEIGHTS[t]) * values[t * KV_DIM + kh * HEAD_DIM + d];
                output[r * HIDDEN + h * HEAD_DIM + d] = rounded_ratio(numerator, denominator);
            }
        }
    }
}

static void residual(const data_t *lhs, const data_t *rhs, data_t *output, int n) {
    for (int i = 0; i < n; ++i) output[i] = saturate_data(wide_t(lhs[i]) + wide_t(rhs[i]));
}

static int run_core(const int32_t *tokens, int token_count, int start_pos, const data_t *weights,
                    const data_t *rope_table, data_t *key_cache, data_t *value_cache,
                    data_t *scratch, data_t *logits) {
    if (token_count < 1 || token_count > PREFILL_TILE || start_pos < 0 || start_pos > MAX_CTX - token_count) return 1;
    for (int r = 0; r < token_count; ++r) if (tokens[r] < 0 || tokens[r] >= VOCAB) return 2;
    data_t *hidden = scratch + SCRATCH_HIDDEN;
    data_t *norm = scratch + SCRATCH_NORM;
    data_t *q = scratch + SCRATCH_Q;
    data_t *k = scratch + SCRATCH_K;
    data_t *v = scratch + SCRATCH_V;
    data_t *context = scratch + SCRATCH_CONTEXT;
    data_t *mid = scratch + SCRATCH_MID;
    data_t *gate = scratch + SCRATCH_GATE;
    data_t *up = scratch + SCRATCH_UP;
    data_t *ffn_out = scratch + SCRATCH_FFN_OUT;
    for (int r = 0; r < token_count; ++r)
        for (int c = 0; c < HIDDEN; ++c)
            hidden[r * HIDDEN + c] = weights[uint64_t(tokens[r]) * HIDDEN + c];
    LLAMA_TRACE("embedding", hidden, token_count, HIDDEN, false);
    for (int layer = 0; layer < LAYERS; ++layer) {
        LLAMA_LAYER(layer);
        uint64_t base = EMBEDDING_COUNT + uint64_t(layer) * LAYER_WEIGHT_COUNT;
        rmsnorm(hidden, weights + base + OFFSET_ATTN_NORM, norm, token_count);
        LLAMA_TRACE("attn_norm", norm, token_count, HIDDEN, false);
        linear(norm, weights + base + OFFSET_Q_PROJ, q, token_count, HIDDEN, HIDDEN);
        LLAMA_TRACE("q_proj", q, token_count, HIDDEN, false);
        linear(norm, weights + base + OFFSET_K_PROJ, k, token_count, HIDDEN, KV_DIM);
        LLAMA_TRACE("k_proj", k, token_count, KV_DIM, false);
        linear(norm, weights + base + OFFSET_V_PROJ, v, token_count, HIDDEN, KV_DIM);
        LLAMA_TRACE("v_proj", v, token_count, KV_DIM, false);
        rope(q, rope_table, token_count, Q_HEADS, start_pos);
        rope(k, rope_table, token_count, KV_HEADS, start_pos);
        LLAMA_TRACE("q_rope", q, token_count, HIDDEN, false);
        LLAMA_TRACE("k_rope", k, token_count, KV_DIM, false);
        uint64_t cache_base = uint64_t(layer) * MAX_CTX * KV_DIM;
        for (int r = 0; r < token_count; ++r)
            for (int c = 0; c < KV_DIM; ++c) {
                key_cache[cache_base + uint64_t(start_pos + r) * KV_DIM + c] = k[r * KV_DIM + c];
                value_cache[cache_base + uint64_t(start_pos + r) * KV_DIM + c] = v[r * KV_DIM + c];
            }
        LLAMA_TRACE("k_cache_update", key_cache + cache_base + uint64_t(start_pos) * KV_DIM, token_count, KV_DIM, true);
        LLAMA_TRACE("v_cache_update", value_cache + cache_base + uint64_t(start_pos) * KV_DIM, token_count, KV_DIM, true);
        attention(q, key_cache + cache_base, value_cache + cache_base, context, token_count, start_pos);
        LLAMA_TRACE("context", context, token_count, HIDDEN, false);
        linear(context, weights + base + OFFSET_O_PROJ, norm, token_count, HIDDEN, HIDDEN);
        LLAMA_TRACE("o_proj", norm, token_count, HIDDEN, false);
        residual(hidden, norm, mid, token_count * HIDDEN);
        LLAMA_TRACE("attn_residual", mid, token_count, HIDDEN, false);
        rmsnorm(mid, weights + base + OFFSET_FFN_NORM, norm, token_count);
        LLAMA_TRACE("ffn_norm", norm, token_count, HIDDEN, false);
        linear(norm, weights + base + OFFSET_GATE_PROJ, gate, token_count, HIDDEN, FFN);
        LLAMA_TRACE("gate_proj", gate, token_count, FFN, false);
        linear(norm, weights + base + OFFSET_UP_PROJ, up, token_count, HIDDEN, FFN);
        LLAMA_TRACE("up_proj", up, token_count, FFN, false);
        for (int i = 0; i < token_count * FFN; ++i) gate[i] = silu_value(gate[i]);
        LLAMA_TRACE("silu", gate, token_count, FFN, false);
        for (int i = 0; i < token_count * FFN; ++i) gate[i] = round_data(wide_t(gate[i]) * up[i], FRAC);
        LLAMA_TRACE("swiglu", gate, token_count, FFN, false);
        linear(gate, weights + base + OFFSET_DOWN_PROJ, ffn_out, token_count, FFN, HIDDEN);
        LLAMA_TRACE("down_proj", ffn_out, token_count, HIDDEN, false);
        residual(mid, ffn_out, hidden, token_count * HIDDEN);
        LLAMA_TRACE("out", hidden, token_count, HIDDEN, true);
    }
    LLAMA_LAYER(-1);
    rmsnorm(hidden, weights + FINAL_NORM_OFFSET, norm, token_count);
    LLAMA_TRACE("final_norm", norm, token_count, HIDDEN, true);
    linear(norm, weights + LM_HEAD_OFFSET, logits, token_count, HIDDEN, VOCAB);
    LLAMA_TRACE("logits", logits, token_count, VOCAB, true);
    return 0;
}

int llama_prefill(const int32_t tokens[PREFILL_TILE], int token_count, int start_pos,
                  const data_t weights[WEIGHT_COUNT], const data_t rope_table[MAX_CTX * HEAD_DIM],
                  data_t key_cache[CACHE_COUNT], data_t value_cache[CACHE_COUNT],
                  data_t scratch[SCRATCH_COUNT], data_t logits[PREFILL_TILE * VOCAB]) {
    #pragma HLS interface m_axi port=tokens offset=slave bundle=control_data
    #pragma HLS interface m_axi port=weights offset=slave bundle=model_weights
    #pragma HLS interface m_axi port=rope_table offset=slave bundle=rope_data
    #pragma HLS interface m_axi port=key_cache offset=slave bundle=keys
    #pragma HLS interface m_axi port=value_cache offset=slave bundle=values
    #pragma HLS interface m_axi port=scratch offset=slave bundle=features
    #pragma HLS interface m_axi port=logits offset=slave bundle=output_data
    #pragma HLS interface s_axilite port=tokens bundle=control
    #pragma HLS interface s_axilite port=weights bundle=control
    #pragma HLS interface s_axilite port=rope_table bundle=control
    #pragma HLS interface s_axilite port=key_cache bundle=control
    #pragma HLS interface s_axilite port=value_cache bundle=control
    #pragma HLS interface s_axilite port=scratch bundle=control
    #pragma HLS interface s_axilite port=logits bundle=control
    #pragma HLS interface s_axilite port=token_count bundle=control
    #pragma HLS interface s_axilite port=start_pos bundle=control
    #pragma HLS interface s_axilite port=return bundle=control
    return run_core(tokens, token_count, start_pos, weights, rope_table, key_cache, value_cache, scratch, logits);
}

int llama_decode(int32_t token, int position,
                 const data_t weights[WEIGHT_COUNT], const data_t rope_table[MAX_CTX * HEAD_DIM],
                 data_t key_cache[CACHE_COUNT], data_t value_cache[CACHE_COUNT],
                 data_t scratch[SCRATCH_COUNT], data_t logits[VOCAB]) {
    #pragma HLS interface m_axi port=weights offset=slave bundle=model_weights
    #pragma HLS interface m_axi port=rope_table offset=slave bundle=rope_data
    #pragma HLS interface m_axi port=key_cache offset=slave bundle=keys
    #pragma HLS interface m_axi port=value_cache offset=slave bundle=values
    #pragma HLS interface m_axi port=scratch offset=slave bundle=features
    #pragma HLS interface m_axi port=logits offset=slave bundle=output_data
    #pragma HLS interface s_axilite port=weights bundle=control
    #pragma HLS interface s_axilite port=rope_table bundle=control
    #pragma HLS interface s_axilite port=key_cache bundle=control
    #pragma HLS interface s_axilite port=value_cache bundle=control
    #pragma HLS interface s_axilite port=scratch bundle=control
    #pragma HLS interface s_axilite port=logits bundle=control
    #pragma HLS interface s_axilite port=token bundle=control
    #pragma HLS interface s_axilite port=position bundle=control
    #pragma HLS interface s_axilite port=return bundle=control
    return run_core(&token, 1, position, weights, rope_table, key_cache, value_cache, scratch, logits);
}
